{
  "name": "christmas-together",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "db:check": "node --env-file-if-exists=.env scripts/database.ts check",
    "db:backup": "node --env-file-if-exists=.env scripts/database.ts backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database.ts restore",
    "privacy:cleanup": "node --env-file-if-exists=.env scripts/database.ts privacy"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "cookie-session": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
