# Local preview defaults: barista / barista-demo and lead / lead-demo.
# Keep .env out of source control. Production is served through an HTTPS proxy.
PORT=3001
# NODE_ENV=production
# SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# BARISTA_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# LEAD_PASSWORD=replace-with-a-different-password-of-at-least-12-characters
# DB_PATH=./data/beans.sqlite
# Set both for Turso. Omit both to keep local SQLite development.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-private-database-token
